# Server only. Never prefix Google credentials with VITE_.
GOOGLE_APPLICATION_CREDENTIALS=./vertex.json
GOOGLE_CLOUD_PROJECT=ai-vertical-495712
GOOGLE_CLOUD_LOCATION=global
# Server-only OpenRouter key with a $0 spending cap; never use VITE_ for this key.
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./server/data/signal.sqlite
MAX_ARTICLE_AGE_HOURS=72
MAX_ARTICLES_PER_RUN=40
MAX_MODEL_CALLS_PER_DAY=2
STUDIO_DAILY_GENERATIONS=10
# Live free inference remains off until access and privacy review are approved.
CONTENT_LIVE_FREE_CALLS=false
# Automatic research is blocked in this content-only implementation.
STUDIO_RESEARCH_SCHEDULER=false
# Paid media remains blocked even when legacy model variables exist.
# STUDIO_IMAGE_MODEL=
# STUDIO_AUDIO_MODEL=
# STUDIO_VIDEO_MODEL=
# STUDIO_MEDIA_LOCATION=us-central1
# STUDIO_IMAGE_ESTIMATE_USD=
# STUDIO_AUDIO_ESTIMATE_USD=
# STUDIO_VIDEO_ESTIMATE_USD=
# STUDIO_VOICE=Kore
# Production media requires a PRIVATE Supabase Storage bucket (32 MB per asset).
# STUDIO_MEDIA_BUCKET=studio-media
REFRESH_INTERVAL_MINUTES=720
FEED_REFRESH_INTERVAL_MINUTES=360
# Enable only for a deliberately started worker; web page visits never invoke the LLM.
ENABLE_SCHEDULER=false

# Optional local Gemini fallback: explicit expiry AND a server monetary ledger limit are required.
# Credentials stay outside the checkout; this does not confirm promotional credit coverage.
CONTENT_VERTEX_FALLBACK=false
# Production Vertex uses keyless Vercel federation only inside an exact paid-demo authorization.
# These public identity settings do not enable global paid fallback; keep CONTENT_VERTEX_FALLBACK=false.
# VERTEX_WIF_AUDIENCE=https://iam.googleapis.com/projects/487106620228/locations/global/workloadIdentityPools/aireels-vercel/providers/aireels-prod
# VERTEX_WIF_SERVICE_ACCOUNT=aireels-vertex@cs-project-bvfzp2zn.iam.gserviceaccount.com
# VERTEX_FALLBACK_PROJECT=
# VERTEX_FALLBACK_CREDENTIALS=C:/private/vertex-service-account.json
VERTEX_FALLBACK_MODEL=gemini-3.8-flash
# VERTEX_FALLBACK_APPROVED_UNTIL=2026-10-29T12:00:00Z

# Production requires Supabase. Keep these values server-side, without VITE_ prefixes.
STORAGE_PROVIDER=sqlite
AUTH_PROVIDER=firebase
# Server-only Hexclave settings. Do not switch provider until migration is verified.
# HEXCLAVE_PROJECT_ID=
# HEXCLAVE_SECRET_SERVER_KEY=
HEXCLAVE_MIGRATION_READY=false
# Explicit reviewed Hexclave subject -> existing Firebase uid mapping; never map by email.
# HEXCLAVE_IDENTITY_MAP_JSON={}
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-server-secret-or-service-role-key
# FIREBASE_PROJECT_ID=your-actual-firebase-project-id
# FIREBASE_WEB_CONFIG={"apiKey":"public-web-key","authDomain":"project.firebaseapp.com","projectId":"project","appId":"web-app-id"}
ADMIN_EMAILS=yeshaswi3@gmail.com
# FIREBASE_ADMIN_CREDENTIALS=./firebase-admin-service-account.json
# Vercel uses JSON environment secrets instead of local credential files:
# GOOGLE_SERVICE_ACCOUNT_JSON={...}
# FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON={...}
# CRON_SECRET=generate-a-random-secret-at-least-32-characters-long
